rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(hid) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }

    match /households/{hid} {
      // 招待コード（hid）を知っている前提のUXなので get は許可するが、
      // 総当たりで存在チェックされないよう一覧列挙は禁止する。
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      // schemaVersion等のメタデータはどのメンバーからでも更新できる必要がある
      // （複数端末対応の移行処理は最初に起動したメンバーの端末が行うため、
      // オーナーの端末とは限らない）。ただし ownerUid 自体はオーナーしか変更できない
      // ようにして、メンバーによるhousehold乗っ取りを防ぐ。
      allow update: if isSignedIn() && isMember(hid) &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /members/{uid} {
        // 自分自身のメンバー文書は、まだメンバーでなくても読めるようにする。
        // isMember() は「メンバー文書が存在すること」なので、これを参加前の
        // 存在確認に使うと「メンバーでないと参加できているか確認できない」という
        // 循環になり、新しい端末が一切参加できなくなる。
        allow read: if isMember(hid) || (isSignedIn() && request.auth.uid == uid);
        // 自分自身のメンバードキュメントのみ作成可能。
        // role: 'owner' を名乗れるのは households/{hid}.ownerUid が自分の場合のみ。
        // role: 'member' での参加(招待コード=hidを知っていれば参加可能)はクライアントから
        // 直接行う。期限・使用回数の制限は設けていない（Cloud Functionsが必要になるため
        // 今回は見送り。hidはランダム40bit相当で総当たりは非現実的という前提）。
        allow create: if isSignedIn() && request.auth.uid == uid &&
          (
            (request.resource.data.role == 'owner' &&
              get(/databases/$(database)/documents/households/$(hid)).data.ownerUid == request.auth.uid)
            || request.resource.data.role == 'member'
          );
        // 本人が自分のメンバー文書を同じ role で書き直すことだけ許可する。
        // クライアント側では既存メンバーなら書き込まないようにしているが、
        // 復旧経路が permission-denied で完全に詰まるのを防ぐための保険。
        // role を書き換える更新は許可しない（member から owner への昇格を防ぐ）。
        allow update: if isSignedIn() && request.auth.uid == uid &&
          request.resource.data.role == resource.data.role;
        allow delete: if false;
      }

      // ===== 複数の赤ちゃんに対応した現行のデータ構造 =====
      // babies/{babyId} ドキュメント自体がプロフィール(生年月日・アレルギー等)を兼ねる。
      match /babies/{babyId} {
        allow read, write: if isMember(hid);

        match /logs/{dateIso} {
          allow read, write: if isMember(hid);
        }

        match /plans/{dateIso} {
          allow read, write: if isMember(hid);
        }

        match /ingredientStatus/{ingredientId} {
          allow read, write: if isMember(hid);
        }
      }

      // ===== 旧データ構造（schemaVersion 2への移行前に作られたhousehold用） =====
      // babies/{babyId}へ移行済みでもドキュメント自体は削除しないため、当面残しておく。
      match /logs/{dateIso} {
        allow read, write: if isMember(hid);
      }

      match /plans/{dateIso} {
        allow read, write: if isMember(hid);
      }

      match /profile/{docId} {
        allow read, write: if isMember(hid);
      }

      match /ingredientStatus/{ingredientId} {
        allow read, write: if isMember(hid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
